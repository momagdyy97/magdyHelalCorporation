# Copy this file to .env and fill in every password.
#   cp .env.example .env
# Never commit .env. Blank passwords are invalid — replace the placeholders.

# --- MySQL (local Docker / VPS Docker only) ---
# InfinityFree gives you different prefixed names in the control panel.
# Do not assume magdi / magdi_hilal exist on shared hosting.
MYSQL_DATABASE=magdi_hilal
MYSQL_USER=magdi
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# Local / VPS container bind. Public WordPress URL is WP_HOME, not this port.
WP_PORT=8088

# Public site URL (authoritative).
WP_HOME=https://magdyhelalcorp.infinityfree.io
WP_SITEURL=https://magdyhelalcorp.infinityfree.io
WP_URL=https://magdyhelalcorp.infinityfree.io

# WP-CLI setup.sh (docker compose --profile tools)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme
WP_ADMIN_EMAIL=momagdyy97@gmail.com

# Optional chat GPT path. Leave empty to use the offline router.
# MHA_OPENAI_API_KEY=
# OPENAI_API_KEY=
