# Copy this file to .env and fill in every password.
#   cp .env.example .env
# Never commit .env. Blank passwords are invalid — replace the placeholders.

# --- MySQL (Docker on laptop or VPS) ---
MYSQL_DATABASE=magdi_hilal
MYSQL_USER=magdi
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Container bind only. Public WordPress URL is WP_HOME, not this port.
WP_PORT=8088

# Public site URL (authoritative). No trailing slash. Canonical apex, not www.
WP_HOME=https://helal.co
WP_SITEURL=https://helal.co
WP_URL=https://helal.co

# WP-CLI setup.sh (docker compose --profile tools)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CHANGE_ME
WP_ADMIN_EMAIL=info@helal.co

# Optional chat GPT path. Leave empty to use the offline router.
# MHA_OPENAI_API_KEY=
# OPENAI_API_KEY=
